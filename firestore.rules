rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Secure rule for AITrips collection
    match /AITrips/{documentId} {
      
      // Allow users to read their own trip documents
      allow read: if request.auth != null && (
        request.auth.token.email == resource.data.userEmail ||
        request.auth.uid == resource.data.userId
      );
      
      // Allow logged-in users to create trip documents for themselves
      allow create: if request.auth != null && (
        request.auth.token.email == request.resource.data.userEmail ||
        request.auth.uid == request.resource.data.userId
      );

      // Allow users to update or delete only their own trip documents
      allow update, delete: if request.auth != null && (
        request.auth.token.email == resource.data.userEmail ||
        request.auth.uid == resource.data.userId
      );
    }
  }
}
